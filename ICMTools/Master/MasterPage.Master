    <style>
        @media (min-width: 768px) {
            .modal-xl {
                width: 90%;
                max-width: 1200px;
            }
        }

        /* Custom CSS for the spinner animation for Bootstrap 4.1.1 */
        .custom-spinner {
            display: inline-block;
            width: 2.5rem; /* Spinner size */
            height: 2.5rem; /* Spinner size */
            vertical-align: middle;
            border: .25em solid currentColor; /* Border color based on text color */
            border-right-color: transparent; /* Makes part of the border transparent for the spinning effect */
            border-radius: 50%; /* Makes it circular */
            animation: spin 0.75s linear infinite; /* Apply the spin animation */
        }

        .custom-spinner-sm {
            width: 1.25rem;
            height: 1.25rem;
            border-width: .2em;
        }

        /* Keyframes for the spinning animation */
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* Styles for the full-page loading overlay */
        .loading-overlay {
            position: fixed; /* Fixed position to cover the entire viewport */
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.7); /* Semi-transparent black background */
            display: flex; /* Use flexbox for centering */
            justify-content: center; /* Center horizontally */
            align-items: center; /* Center vertically */
            z-index: 9999; /* Ensure it's on top of everything */
            color: white; /* Spinner color for the overlay */
            transition: opacity 0.3s ease-in-out; /* Smooth fade effect */
            opacity: 0; /* Initially hidden */
            pointer-events: none; /* Allows clicks to pass through when hidden */
        }

            .loading-overlay.show {
                opacity: 1; /* Show the overlay */
                pointer-events: auto; /* Enable interaction when shown */
            }


        /* Estilo para posicionar la alerta en la parte inferior y a todo lo ancho */
        .alert-container {
            position: fixed; /* Fijo en la ventana del navegador */
            bottom: 0; /* Pegado a la parte inferior */
            left: 0; /* Pegado al borde izquierdo */
            right: 0; /* Pegado al borde derecho (hace que ocupe el 100% del ancho) */
            z-index: 1050; /* Para que esté por encima de la mayoría de los elementos de Bootstrap (ej. navbars, modales) */
            padding: 0; /* Remover cualquier padding predeterminado del contenedor */
            margin: 0; /* Remover cualquier margen predeterminado del contenedor */
        }

            /* Ajustes adicionales para la alerta dentro del contenedor si es necesario */
            .alert-container .alert {
                margin-bottom: 0; /* Las alertas de Bootstrap tienen un margin-bottom por defecto, lo quitamos */
                border-radius: 0; /* Opcional: Quita los bordes redondeados para que se vea más como una barra sólida */
            }
    </style>

</head>
