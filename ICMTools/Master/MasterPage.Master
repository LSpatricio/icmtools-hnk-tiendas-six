    <!-- Modal Global de Bloqueo (Control de Intentos) -->
    <div class="modal fade" id="modalGlobalBloqueo" tabindex="-1"
         role="dialog" aria-labelledby="modalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modalLabel">
                        <i class="fas fa-user-lock mr-2">Acceso Restringido</i>
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times</span>
                    </button>
                </div>
                <div class="modal-body text-center p-4">
                    <i class="fas fa-exclamation-circle fa-4x text-danger mb-3"></i>
                    <h4 class="mb-3">¡Límite de intentos excedido!</h4>
                    <p id="mensajeBloqueoGlobal">
                        Has alcanzado el límite de intentos permitido para esta operación.<br />
                        Por seguridad, la funcion ha sido bloqueada temporalmente.
                    </p>
                    <hr />
                    <p class="text-muted small">
                        Por favor, contacta a soporte técnico para solicitar el desbloqueo o revisar los logs del sistema.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

</body>

<script>

    var myWebServiceURLMasterPage = "<%= Page.ResolveClientUrl("~/WebServices/WebServicesMasterPage.asmx")%>";


    $(document).ready(function () {
        $('#hamburger').click(function () {
            $('#sidebar, #content').toggleClass('active');
        });

        // --- Custom ScrollSpy
        var scrollNav = $('#MyScrollNav');

        // Solo ejecutar este código si el menú de navegación existe en la página actual
        if (scrollNav.length) {
            // Configuración
            var navLinks = scrollNav.find('.nav-link');
            var sections = $();
            navLinks.each(function () {
                var hash = this.hash;
                // Asegurarse de que el 'hash' (ej. #item-1) es válido y el elemento existe
                if (hash && $(hash).length) {
                    sections = sections.add($(hash));
                }
            });
            var offset = 90; // Offset para la barra de navegación superior

            // Función para actualizar el menú en el scroll
            function updateNav() {
                var scrollPos = $(window).scrollTop() + offset + 1;

                var currentSection = null;
                sections.each(function () {
                    var sectionTop = $(this).offset().top;
                    if (scrollPos >= sectionTop) {
                        currentSection = this;
                    }
                });

                var id = currentSection ? '#' + currentSection.id : null;

                navLinks.removeClass('active');
                if (id) {
                    navLinks.filter('[href="' + id + '"]').addClass('active');
                } else {
                    // Si no hay sección activa (estamos arriba de todo), activa la primera
                    navLinks.first().addClass('active');
                }
            }

            // Evento de scroll
            $(window).on('scroll', updateNav);

            // Evento de clic para un scroll suave y resaltado inmediato
            navLinks.on('click', function (e) {
                var target = this.hash;
                if (target && $(target).length) {
                    e.preventDefault();

                    // Resaltado inmediato
                    navLinks.removeClass('active');
                    $(this).addClass('active');

                    // Animación de scroll
                    $('html, body').animate({
                        scrollTop: $(target).offset().top - offset
                    }, 500);
                }
            });

            // Llama a la función una vez al cargar la página para el estado inicial
            updateNav();
        }
    });

    icmTools = {};

    icmTools.dropListModelo = () => {
        var droplist = {};

        droplist.Init = () => {
            document.querySelector(".dropdown-menu").addEventListener("click", (e) => {
                const target = e.target.closest(".dropdown-item");
                if (!target) return;

                const modeloSeleccionado = target.getAttribute("aria-valuetext");
                droplist.CambiarModelo(modeloSeleccionado);
            });
        };
        
        droplist.CambiarModelo = (modeloSeleccionado) => {
            $.ajax({
                type: "POST",
                url: myWebServiceURLMasterPage + "/ChangeUserModel",
                data: JSON.stringify({ modelo: modeloSeleccionado }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function () {
                    console.log(modeloSeleccionado); // usar el parámetro recibido
                    window.location.href = '../Pages/Home.aspx';;
                },
                error: function (XMLHttpRequest, textStatus, errorThrown) {
                    icmTools.hideLoading();
                    let msg = XMLHttpRequest.responseJSON?.Message || "Error desconocido";
                    icmTools.AlertError('<strong>¡Error!</strong> ' + msg);
                    console.error("Error en la llamada AJAX a ChangeUserModel:");
                    console.error("Estado del texto:", textStatus);
                    console.error("Error lanzado:", errorThrown);
                    console.error("Respuesta del servidor (cruda):", XMLHttpRequest.responseText);
                }
            });
        };

        return droplist; 
    };


    icmTools.modal = (id) => {
        var modal = {};
        modal.Show = (id) => {
            modal.onShow(id);

            $('#exampleModal').modal('show')
        }
        modal.onShow = (id) => {
            $('#exampleModal').off('show.bs.modal').on('show.bs.modal', function (event) {
                var modal = $(this)
                var htmlModal = modal.get(0);
                var dialogs = htmlModal.getElementsByClassName("modal-dialog");

                const CreateModal = () => {
                    modalDialog.className.replace("modal-lg", "")
                    modalDialog.className.replace("modal-sm", "")

                    var context = htmlModal.querySelector("[id='" + id + "']")
                    //Al no existir el contexto se abre el modal vacio
                    if (!context) return

                    var body = context.querySelector(("[modal-id='Body']"));
                    var modalBody = modalDialog.getElementsByClassName("modal-body")[0];
                    modalBody.innerHTML = ''
                    if (body && body.childNodes.length > 0) {

                        body.childNodes.forEach(child => {
                            let clonedChild = child.cloneNode(true);
                            modalBody.appendChild(clonedChild);
                        })

                    }
                    var foot = context.querySelector(("[modal-id='Foot']"));
                    var modalfoot = modalDialog.getElementsByClassName("modal-footer")[0];
                    modalfoot.innerHTML = ''
                    if (foot && foot != null && foot.childNodes.length > 0) {
                        foot.childNodes.forEach(child => {
                            let clonedChild = child.cloneNode(true);
                            modalfoot.appendChild(clonedChild);
                        })

                    }

                    var header = context.querySelector(("[modal-id='Header']"));
                    var modalheader = modalDialog.getElementsByClassName("modal-header")[0];
                    if (header && header.childNodes.length > 0) {
                        modalheader.innerHTML = ''
                        header.childNodes.forEach(child => {
                            let clonedChild = child.cloneNode(true);
                            modalheader.appendChild(clonedChild);
                        })
                    }
                    if (context.attributes["modal-title"] && !header) {
                        var modalTitle = context.attributes["modal-title"];
                        modalheader.firstElementChild.textContent = modalTitle.value;
                    }


                    if (context.attributes["modal-size"]) {
                        var modalSize = context.attributes["modal-size"]
                        var size = modalSize.value.toString().toUpperCase();
                        if (isNaN(size)) {
                            let checkSizes = ["LG", 'SM', 'MD', 'XL'];
                            if (checkSizes.includes(size)) {
                                modalDialog.classList.add("modal-" + size.toLowerCase())
                            }

                        }
                    } else modalDialog.classList.add("modal-md")

                    if (context.attributes["modal-onload"]) {
                        modalDialog.setAttribute("modal-onload", context.attributes["modal-onload"].value)
                    }

                    context.remove();
                }

                const SearchDialog = (_idDialog) => {

                    var filterDialog = [];
                    for (let i = 0; i < dialogs.length; i++) {
                        var idDialog = dialogs[i].getAttribute("idDialog")
                        if (idDialog == _idDialog) {
                            filterDialog.push(dialogs[i]);
                        }
                    }
                    return filterDialog
                }


                const clean = () => {
                    for (let i = 0; i < dialogs.length; i++) {
                        var item = dialogs[i];
                        var idDialog = item.getAttribute("idDialog")
                        item.setAttribute("style", "display:none")
                        if (idDialog == id) {
                            item.removeAttribute("style", "display:none")
                        }
                    }
                }
                var events = {
                    onload: () => { }
                }

                var filter = SearchDialog(id)

                if (filter.length > 0) {
                    modalDialog = filter[0];
                } else {
                    var template = SearchDialog("template")[0].cloneNode(true);

                    //modalDialog = htmlModal.getElementsByClassName("modal-dialog")[0]
                    modalDialog = template;
                    modalDialog.setAttribute("idDialog", id);
                    CreateModal();
                    htmlModal.appendChild(modalDialog)


                }

                clean();

                if (modalDialog.attributes["modal-onload"]) {
                    var func_onload = window[modalDialog.attributes["modal-onload"].value.trim()]
                    if (func_onload) func_onload()

                }

            })
        }


        modal.Show(id);
        /*  $('#exampleModal').modal('show')*/
    }

    icmTools.showLoading = (text) => {
        var show = document.getElementById('loadingOverlay')
        var input = show.getElementsByTagName("P")[0];
        input.innerText = text ? text : 'Cargando contenido...'
        show.classList.add('show');

    }
    icmTools.hideLoading = () => {
        document.getElementById('loadingOverlay').classList.remove('show');
    }

    icmTools.Datatable = (id, ...args) => {
        var local = {};
        local.id = "#" + id;

        var config = {};
        config.lengthMenu = [[10, 20, 30, -1], [10, 20, 30, "Todos"]];
        config.responsive = true;
        config.dom = 'Bfrtip';
        config.buttons = [
            //'copy', 'csv', 'excel', 'pdf', 'print'
            //'copy', 'excel'
            [
                {
                    extend: 'copy',
                    text: '<i class="fas fa-copy fa-fw"></i>Copiar',
                    className: 'btm-sm btn-outline-info',
                    title: null,
                    messageTop: null,
                    exportOptions: {
                        modifier: {
                            page: 'all'
                        }
                    }
                }
            ],
            [
                {
                    extend: 'excel',
                    text: '<i class="fas fa-file-excel fa-fw"></i>Exportar',
                    className: 'btm-sm btn-outline-success',
                    //filename: "Errores en carga de Excepciones",
                    title: null,
                    messageTop: null,
                    exportOptions: {
                        modifier: {
                            page: 'all'
                        }
                    }
                }
            ],
        ];
        config.language = {
            "decimal": "",
            "emptyTable": "No hay información disponible", //No data available in table",
            "info": "Mostrando de _START_ a _END_ de _TOTAL_ registros", //"Showing _START_ to _END_ of _TOTAL_ entries",
            "infoEmpty": "Mostrando 0 a 0 de 0 registros", //"Showing 0 to 0 of 0 entries",
            "infoFiltered": "(filto de _MAX_ registros)", //"(filtered from _MAX_ total entries)",
            "infoPostFix": "",
            "thousands": ",",
            "lengthMenu": "Mostrar _MENU_ registros", //"Show _MENU_ entries",
            "loadingRecords": "Cargando...", //"Loading...",
            "processing": "Procesando...", //"Processing...",
            "search": "Buscar", //"Search:",
            "zeroRecords": "No se encontraron coincidencias", //"No matching records found",
            "paginate": {
                "first": "Primera", //"First",
                "last": "Ultima", //"Last",
                "next": "Siguiente", //"Next",
                "previous": "Anterior", //"Previous"
            },
            "aria": {
                "sortAscending": ": activate to sort column ascending",
                "sortDescending": ": activate to sort column descending"
            }
        }
        config.columns = [];

        args.forEach(param => {

            if (typeof param == 'object') {

                if (Array.isArray(param)) {
                    config.data = param;
                } else {
                    Object.keys(param).forEach(att => {
                        config[att] = param[att];
                    })
                }
            }

        })
        let tableDom = document.getElementById(id);
        if ($.fn.dataTable.isDataTable(local.id)) {
            $(local.id).DataTable().clear();
            $(local.id).DataTable().destroy();
            $(local.id).empty();
        }

        return $(local.id).DataTable(config);

    }
    $showAlert = (type, message, autoHide = true, duration = 2000) => {
        // Genera el HTML de la alerta con las clases de Bootstrap
        const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show z-3" role="alert" style="z-index: 999999;">
                        ${message}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                `;

        // Selecciona el contenedor de las alertas
        const $alertPlaceholder = $('#alertPlaceholder');
        // Inserta el nuevo HTML de la alerta en el contenedor (reemplaza cualquier alerta anterior)
        $alertPlaceholder.html(alertHtml);

        // Obtiene la instancia jQuery de la alerta recién creada
        const $newAlert = $alertPlaceholder.find('.alert');

        // Registra el evento 'closed.bs.alert' que se dispara DESPUÉS de que la animación de cierre haya terminado.
        // Esto es crucial para limpiar el HTML del placeholder cuando la alerta ya no es visible.
        $newAlert.on('closed.bs.alert', function () {
            $alertPlaceholder.empty(); // Vacía el contenedor de la alerta
        });

        // Si se solicita auto-ocultar, configura un temporizador
        if (autoHide) {
            setTimeout(function () {
                // Usa el método 'close' de Bootstrap para iniciar la animación de salida
                // Esto disparará el evento 'closed.bs.alert' una vez que la animación termine
                $newAlert.alert('close');
            }, duration);
        }
    }

    $showAlertModal = (type, message, func) => {
        var modal = document.getElementById("ALERTModal")
        var body = modal.getElementsByClassName("modal-body")[0]
        var header = modal.getElementsByClassName("modal-title")[0]
        var title = type
        switch (type) {
            case "danger":
                title = "Error de sistema"
                break;
            case "success":
                title = "Exito!!"
                break;
            case "info":
                title = "Informacion del sistema"
                break;
        }

        header.innerHTML = title;

        body.innerHTML = message;
        var btn = document.getElementById("btnModalAlertAceptar")
        btn.onclick = () => {
            if (func) {
                func();
            }
        }

        $('#ALERTModal').modal('show')
    }
    //icmTools.AlertError = (message, type = "A", autoHide = true, duration = 2500) => {

    icmTools.AlertError = (message, ...args) => {
        let alert = {};
        alert.message = message;
        alert.autoHide = true;
        alert.duration = 2500;
        alert.function = undefined;
        alert.type = "danger"
        alert.typeAlert = "A"
        args.forEach(arg => {
            switch (typeof arg) {
                case "boolean":
                    alert.autoHide = arg;
                    break;
                case "number":
                    alert.duration = arg;
                    break;
                case "function":
                    alert.function = arg;
                    break;
                case "string":
                    alert.typeAlert = arg;
                    break;
            }


        })


        switch (alert.typeAlert) {
            case "A":
                $showAlert(alert.type, alert.message, alert.autoHide, alert.duration)
                break;
            case "M":
                $showAlertModal(alert.type, alert.message, alert.function)
                break
        }
    }
